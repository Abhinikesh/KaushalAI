# client/.env.production.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy to client/.env.production and set before running `npm run build`.
# For Docker Compose: pass as build arg in docker-compose.prod.yml instead.
# NEVER commit .env.production to git.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for API calls from the browser.
# Docker Compose (behind nginx): /api  (nginx routes /api/* to the Node server)
# Render/Railway split (separate backend): https://kaushalai-api.onrender.com/api
VITE_API_BASE_URL=/api
