# ── KaushalAI Backend Environment Configuration ────────────────────────────────
# Safe example values only. Never commit real secrets or production credentials.

PORT=5000
NODE_ENV=development

# ── MongoDB Connection String ──────────────────────────────────────────────────
# Standard MongoDB URI (local or MongoDB Atlas / managed cluster)
MONGO_URI=mongodb://localhost:27017/kaushalai
# Alternatively, MONGODB_URI is also accepted:
# MONGODB_URI=mongodb://localhost:27017/kaushalai

# ── Reverse Proxy & Networking ─────────────────────────────────────────────────
# Number of trusted reverse proxy hops (e.g. 1 for single Nginx/Render/Cloudflare layer)
TRUST_PROXY=1

# ── Client CORS Origins ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production
CLIENT_ORIGIN=http://localhost:3000
# CLIENT_URL=https://kaushalai.gov.in

# ── Cryptographic Secrets ──────────────────────────────────────────────────────
# Production REQUIRES minimum 32-character random cryptographic secrets.
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_access_token_32chars
REFRESH_TOKEN_SECRET=replace_with_a_long_random_secret_refresh_token_32char
COOKIE_SECRET=replace_with_a_long_random_secret_cookie_secret_32chars

# ── AI Microservice & Internal Communication ──────────────────────────────────
# Local dev: http://localhost:8000 | Docker Compose: http://ai-service:8000
AI_SERVICE_URL=http://localhost:8000
# Shared internal token between Node.js backend and Python AI microservice
INTERNAL_SERVICE_TOKEN=replace_with_a_long_random_secret_internal_token_32c

# ── External Identity Providers (Google Sign-In) ──────────────────────────────
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Email domain restriction (comma-separated; empty string = no restriction for local dev)
# Example for production: ALLOWED_EMAIL_DOMAINS=gov.in,nic.in,mospi.gov.in
ALLOWED_EMAIL_DOMAINS=

# ── Course Content Adapters ───────────────────────────────────────────────────
# "mock" uses seeded MongoDB courses (default, no external credentials needed)
# "live" connects to real external APIs using the keys below
COURSE_SOURCE_MODE=mock

# iGOT Karmayogi API (required only if COURSE_SOURCE_MODE=live)
IGOT_API_BASE_URL=https://api.igot.gov.in
IGOT_API_KEY=your_igot_api_key_here

# NSSTA TPAC API (required only if COURSE_SOURCE_MODE=live)
NSSTA_API_BASE_URL=https://api.nssta.gov.in
NSSTA_API_KEY=your_nssta_api_key_here
