PORT=5000
MONGO_URI=mongodb://localhost:27017/kaushalai
REDIS_URL=redis://localhost:6379
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_access
REFRESH_TOKEN_SECRET=replace_with_a_long_random_secret_refresh
COOKIE_SECRET=replace_with_a_long_random_secret_cookie

# ── AI Service ─────────────────────────────────────────────────────────────────
# Local dev: http://localhost:8000 | Docker Compose: http://ai-service:8000
AI_SERVICE_URL=http://localhost:8000

# ── Course Source Adapters ─────────────────────────────────────────────────────
# "mock" uses your seeded MongoDB data (default, no external credentials needed)
# "live" calls real external APIs — requires the API keys below
COURSE_SOURCE_MODE=mock

# iGOT Karmayogi API (only needed when COURSE_SOURCE_MODE=live)
IGOT_API_BASE_URL=https://api.igot.gov.in
IGOT_API_KEY=your_igot_api_key_here

# NSSTA TPAC API (only needed when COURSE_SOURCE_MODE=live)
NSSTA_API_BASE_URL=https://api.nssta.gov.in
NSSTA_API_KEY=your_nssta_api_key_here

# Internal service auth (shared secret between Node and ai-service)
INTERNAL_SERVICE_TOKEN=replace_with_long_random_hex_token

# Google OAuth (Part D — Google Sign-In)
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Email domain restriction (empty = no restriction, for testing with gmail.com)
# Example for production: ALLOWED_EMAIL_DOMAINS=gov.in,nic.in
ALLOWED_EMAIL_DOMAINS=
