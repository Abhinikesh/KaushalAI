# server/.env.production.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to server/.env.production and fill in real values.
# NEVER commit .env.production to git.
# ─────────────────────────────────────────────────────────────────────────────

# Port the Node server listens on inside the container (leave as 5000)
PORT=5000

# MongoDB connection string.
# Docker Compose internal: mongodb://mongo:27017/kaushalai
# Atlas (recommended for prod): from Atlas dashboard → Connect → Drivers → Node.js
MONGO_URI=mongodb://mongo:27017/kaushalai

# Redis connection string.
# Docker Compose internal: redis://redis:6379
# Upstash (recommended for prod): from Upstash console → your DB → REST API → Redis URL
REDIS_URL=redis://redis:6379

# Must be "production" — enables secure cookies, disables stack traces in API errors
NODE_ENV=production

# The exact origin URL of the deployed frontend (no trailing slash).
# Used for CORS — must match what users actually type in the browser.
# Docker Compose: https://yourdomain.com
# Render/Railway split: https://kaushalai-client.onrender.com (your actual URL)
CLIENT_ORIGIN=https://yourdomain.com

# ── JWT / Cookie secrets ───────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 chars and NOT the placeholder value from .env.example.

ACCESS_TOKEN_SECRET=GENERATE_WITH_CRYPTO_RANDOMBYTES_48_HEX
REFRESH_TOKEN_SECRET=GENERATE_WITH_CRYPTO_RANDOMBYTES_48_HEX
COOKIE_SECRET=GENERATE_WITH_CRYPTO_RANDOMBYTES_48_HEX

# ── Internal service auth ──────────────────────────────────────────────────────
# Shared secret between Node server and ai-service.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match INTERNAL_SERVICE_TOKEN in ai-service/.env.production
INTERNAL_SERVICE_TOKEN=GENERATE_WITH_CRYPTO_RANDOMBYTES_32_HEX

# URL of the ai-service as seen from the Node server container.
# Docker Compose: http://ai-service:8000
# Render/Railway split: https://kaushalai-ai.onrender.com (your actual ai-service URL)
AI_SERVICE_URL=http://ai-service:8000

# ── Course source adapters ────────────────────────────────────────────────────
# "mock" uses seeded MongoDB data (safe for hackathon demo)
# "live" calls real iGOT/NSSTA APIs (requires API keys below)
COURSE_SOURCE_MODE=mock

# iGOT Karmayogi API (only if COURSE_SOURCE_MODE=live)
IGOT_API_BASE_URL=https://api.igot.gov.in
IGOT_API_KEY=

# NSSTA TPAC API (only if COURSE_SOURCE_MODE=live)
NSSTA_API_BASE_URL=https://api.nssta.gov.in
NSSTA_API_KEY=
