# ai-service/.env.production.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ai-service/.env.production and fill in real values.
# NEVER commit .env.production to git.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=KaushalAI AI Service

# Set to false in production — disables /docs and /redoc endpoints
DEBUG=false

# MongoDB connection (for gap analysis and recommendation features)
# Docker Compose internal: mongodb://mongo:27017/kaushalai
# Atlas: your Atlas connection string
MONGO_URI=mongodb://mongo:27017/kaushalai

# Redis connection
# Docker Compose internal: redis://redis:6379
# Upstash: your Upstash Redis URL
REDIS_URL=redis://redis:6379

# Anthropic API key for MCQ generation.
# From: https://console.anthropic.com → API Keys
# Ensure you have sufficient credits/rate limits for demo-day traffic.
# Claude Haiku (default) costs ~$0.25/million input tokens — generous for a demo.
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_REAL_KEY

# Internal token — must match server INTERNAL_SERVICE_TOKEN exactly.
# Used by the middleware guard on all /internal/* routes.
INTERNAL_SERVICE_TOKEN=GENERATE_WITH_CRYPTO_RANDOMBYTES_32_HEX

# Origin of the Node server (for CORS allow-list — not the browser, not the client).
# Docker Compose: http://server:5000
# Render/Railway split: https://kaushalai-api.onrender.com
NODE_SERVER_ORIGIN=http://server:5000

# ChromaDB persistent vector store directory (relative to /app inside the container)
CHROMA_DATA_DIR=./chroma_data
