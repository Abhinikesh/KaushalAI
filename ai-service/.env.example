APP_NAME=KaushalAI AI Service
DEBUG=false
MONGO_URI=mongodb://localhost:27017/kaushalai
REDIS_URL=redis://localhost:6379

# ── Stage 7: MCQ Generator ─────────────────────────────────────────────────────
# Required — service will warn at startup and fail at request time if not set
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ChromaDB vector store directory (relative to ai-service/, created automatically)
CHROMA_DATA_DIR=./chroma_data

# Internal token — must match server INTERNAL_SERVICE_TOKEN
INTERNAL_SERVICE_TOKEN=replace_with_long_random_hex_token
# Origin of Node server (for CORS allow-list)
NODE_SERVER_ORIGIN=http://localhost:5000
